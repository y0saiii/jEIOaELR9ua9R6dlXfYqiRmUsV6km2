{
  "manifest_version": 3,
  "name": "IsraelCord",
  "version": "4.7.0",
  "description": "Mass-delete your Discord messages right inside Discord.",
  "permissions": ["storage", "scripting", "tabs", "webRequest"],
  "host_permissions": ["https://discord.com/*", "https://discordapp.com/*"],
  "action": {
    "default_title": "Toggle IsraelCord",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://discordapp.com/*"],
      "js": ["prunecord.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/logo.png", "tokendetect.js"],
      "matches": ["https://discord.com/*", "https://discordapp.com/*"]
    }
  ]
}
